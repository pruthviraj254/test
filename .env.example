# Admin API (update check)
NEXT_PUBLIC_UPDATE_SERVER_URL=http://localhost:3000/update/check

# Next.js renderer dev server (must differ from BE port)
NEXT_DEV_SERVER_URL=http://localhost:3001

# Optional — NSIS app-update.yml metadata
UPDATE_PUBLISH_URL=http://localhost:3000/update/feed
UPDATE_CHANNEL=stable

