{
  "name": "betauser-test",
  "productName": "betauser-test",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:next\" \"npm:dev:electron\"",
    "dev:next": "next dev ./src/renderer -p 3001",
    "dev:electron": "wait-on http://localhost:3001 && cross-env NEXT_DEV_SERVER_URL=http://localhost:3001 electron-forge start",
    "build:next": "next build ./src/renderer",
    "start": "npm run dev",
    "package": "npm run build:next && electron-forge package",
    "make": "npm run build:next && electron-forge make",
    "make:win": "npm run build:next && electron-forge make --platform=win32 --arch=x64",
    "publish": "npm run build:next && electron-forge publish",
    "release:tag": "node scripts/release-tag.js",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [],
  "author": {
    "name": "Pruthvi Parmar",
    "email": "ppruthviraj254@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron-forge/publisher-static": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@felixrieseberg/electron-forge-maker-nsis": "^7.2.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "css-loader": "^6.11.0",
    "dotenv": "^17.4.2",
    "dotenv-webpack": "^9.0.0",
    "electron": "42.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "node-loader": "^2.1.0",
    "postcss": "^8.5.15",
    "style-loader": "^3.3.4",
    "tailwindcss": "^4.3.0",
    "ts-loader": "^9.5.7",
    "typescript": "^5.9.3",
    "uuid": "^14.0.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^8.2.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
